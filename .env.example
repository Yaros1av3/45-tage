# Diese Datei kopieren zu ".env.local" und die Werte eintragen. ".env.local" NIE auf GitHub hochladen!

# VAPID-Schlüssel: erzeugen mit   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:deine@email.de

# Supabase: Project Settings -> API
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Ein langes, selbst ausgedachtes Passwort für den Cron-Aufruf
CRON_SECRET=
